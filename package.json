{
  "name": "stefanus-login-presentation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test test/unit.test.js",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 test/integration.test.js",
    "test:all": "pnpm test && pnpm test:integration",
    "format": "prettier --write src"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "supertest": "^7.1.4"
  }
}
